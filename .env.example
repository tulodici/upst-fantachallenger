NODE_ENV=production
# Railway fornisce DATABASE_URL (plugin PostgreSQL) e PORT
DATABASE_URL=
BOT_TOKEN=            # token di @BotFather
PUBLIC_URL=https://<dominio-railway>   # abilita webhook + pulsante Mini App
ADMIN_TELEGRAM_IDS=111111,222222       # ID Telegram degli admin
SPORTSAPI365_BASE_URL=
SPORTSAPI365_KEY=
# SPORTSAPI365_AUTH_HEADER=x-api-key
# SPORTSAPI365_RANKING_PATH=/tennis/rankings/atp
# SPORTSAPI365_TOURNAMENTS_PATH=/tennis/tournaments
# SPORTSAPI365_RESULTS_PATH=/tennis/tournaments/{id}/results
API_MONTHLY_LIMIT=150
# ALLOW_CAPTAIN_IN_ROSTER=1   # default: il capitano non puo' stare anche in rosa
# Solo sviluppo: MOCK_API=1 DEV_AUTH=1 DEMO_SEED=1 FAKE_NOW=2026-11-23T09:00:00Z

# Solo collaudo: finestra di selezione sempre aperta sulla settimana corrente (rimuovere prima del lancio)
# TEST_WINDOW_OPEN=1
